# Minimo 32 caracteres aleatorios. Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
# Nunca usar el valor por defecto ni dejarlo vacio en produccion
SECRET_KEY=

# production o development. En el servidor siempre production
FLASK_ENV=production

# Formato: mongodb+srv://user:pass@cluster.mongodb.net/ticketapp
# En MongoDB Atlas: Database > Connect > Drivers > copiar connection string
MONGO_URI=

# pk_live_... para produccion, pk_test_... para pruebas
# Obtener en: Stripe Dashboard > Developers > API keys
STRIPE_PUBLIC_KEY=

# sk_live_... para produccion, sk_test_... para pruebas
STRIPE_SECRET_KEY=

# whsec_... obtenido al registrar el endpoint en Stripe Dashboard > Developers > Webhooks
# El endpoint a registrar es: https://tudominio.com/checkout/webhook
STRIPE_WEBHOOK_SECRET=

# smtp.gmail.com o el servidor de tu proveedor (Resend, Brevo, etc.)
MAIL_SERVER=smtp.gmail.com

# Puerto SMTP: 587 para TLS (recomendado), 465 para SSL
MAIL_PORT=587

# Usar cifrado TLS para la conexion SMTP
MAIL_USE_TLS=True

# Direccion de email remitente
MAIL_USERNAME=

# Contrasena o App Password de Gmail (Cuenta > Seguridad > Contrasenas de aplicaciones)
MAIL_PASSWORD=

# Contrasena del panel /admin. Usa una contrasena fuerte
ADMIN_PASSWORD=

# URL publica de la aplicacion, sin barra final. Critico para QRs y URLs de Stripe
# Ejemplo: https://tudominio.com
BASE_URL=

# URL de conexion a Redis para el rate limiter (compartido entre workers)
# redis://localhost:6379/0 si Redis es local, o URL de Redis Cloud
REDIS_URL=redis://localhost:6379/0
